{
  "schemaVersion": 1,
  "settings": {
    "downloadRateLimitKBps": 0,
    "uploadRateLimitKBps": 0,
    "maximumActiveDownloads": 3,
    "maximumActiveSeeds": 5,
    "stopSeedingRatioPercent": 200,
    "stopSeedingAfterHours": 24,
    "incomingPort": 0,
    "acceptIncomingConnections": false,
    "usePortForwarding": false,
    "enableDHTNetwork": true,
    "useDHTByDefault": true,
    "dhtDiscoveryPolicy": 0,
    "dhtPrivacyLookups": true,
    "reduceDHTContribution": false,
    "enablePeerExchangePlugin": false,
    "usePeerExchangeByDefault": false,
    "httpsTrackerPolicy": 3,
    "httpsWebSeedPolicy": 3,
    "enableLocalServiceDiscovery": false,
    "useLocalServiceDiscoveryByDefault": false,
    "protocolEncryption": 1,
    "anonymousMode": true,
    "requireNetworkInterface": true,
    "showOnlyVPNInterfaces": true,
    "requiredNetworkInterfaceName": "utun4",
    "completionNotificationsEnabled": true,
    "completionNotificationSoundEnabled": true,
    "completionNotificationNamesEnabled": false,
    "dockTransferRatesEnabled": true,
    "preventSleepDuringTransfers": false
  }
}
