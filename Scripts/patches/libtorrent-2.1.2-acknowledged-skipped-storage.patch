+	std::shared_future<error_code> torrent::set_file_priority_checked(file_index_t index, download_priority_t priority)
+	{
+		if (m_checked_file_priority || m_abort || !m_storage || !valid_metadata()
+			|| index < file_index_t{0} || index >= m_torrent_file->layout().end_file()
+			|| m_torrent_file->layout().pad_file_at(index))
+			throw_ex<system_error>(errors::invalid_torrent_handle);
+		m_checked_file_priority = std::make_unique<checked_file_priority>(index, priority);
+		auto result = m_checked_file_priority->completion.get_future().share();
+		submit_checked_file_priority();
+		return result;
+	}
+
+	void torrent::submit_checked_file_priority()
+	{
+		if (!m_checked_file_priority || m_checked_file_priority->submitted || m_outstanding_file_priority) return;
+		if (m_abort || !m_storage)
+		{
+			m_checked_file_priority->completion.set_value(errors::torrent_removed);
+			m_checked_file_priority.reset();
+			return;
+		}
+		m_checked_file_priority->submitted = true;
+		try
+		{
+			set_file_priority(m_checked_file_priority->index, m_checked_file_priority->priority);
+		}
+		catch (...)
+		{
+			m_checked_file_priority->completion.set_exception(std::current_exception());
+			m_checked_file_priority.reset();
+		}
 	}
 
