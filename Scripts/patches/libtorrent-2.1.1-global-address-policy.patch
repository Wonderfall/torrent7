+	// Session-wide RFC 7050 discovery state. IPv4 classification is always
+	// available. IPv6 classification waits for the current network generation
+	// and fails closed if discovery cannot produce a trustworthy result.
+	struct nat64_discovery_state
+	{
+		std::uint64_t start_lookup()
+		{
+			pending = true;
+			return ++generation;
+		}
+
+		bool lookup_completed(std::uint64_t const lookup_generation
+			, nat64_discovery_result result)
+		{
+			if (!pending || lookup_generation != generation) return false;
+			discovery = std::move(result);
+			complete = true;
+			pending = false;
+			return true;
+		}
+
+		bool lookup_timed_out(std::uint64_t const lookup_generation)
+		{
+			if (!pending || lookup_generation != generation) return false;
+			++generation;
+			discovery = {};
+			complete = true;
+			pending = false;
+			return true;
+		}
+
+		void reset()
+		{
+			++generation;
+			discovery = {};
+			complete = false;
+			pending = false;
+		}
+
+		global_address_classification classify(address const& addr) const
+		{
+			if (addr.is_v4())
+				return is_global(addr) ? global_address_classification::global
+					: global_address_classification::non_global;
+			if (!complete) return global_address_classification::pending;
+			if (!discovery.valid) return global_address_classification::unavailable;
+			return is_global(addr, discovery) ? global_address_classification::global
+				: global_address_classification::non_global;
+		}
