+TORRENT_TEST(session_nat64_discovery_is_fail_closed_for_peers)
+{
+	TEST_CHECK(!aux::should_discover_nat64(false, false, false));
+	TEST_CHECK(aux::should_discover_nat64(true, false, false));
+	TEST_CHECK(aux::should_discover_nat64(false, true, false));
+	TEST_CHECK(aux::should_discover_nat64(false, false, true));
+
+	aux::nat64_discovery_state state;
+	TEST_CHECK(state.is_peer_address_global(addr("8.8.8.8")));
+	TEST_CHECK(!state.is_peer_address_global(addr("2606:4700:4700::1111")));
+	TEST_CHECK(!state.is_peer_address_global(addr("2001:4860:abcd:ef01::a00:1")));
+	std::uint64_t const timed_out_generation = state.start_lookup();
+	TEST_CHECK(state.pending);
+	TEST_CHECK(!state.is_peer_address_global(addr("2606:4700:4700::1111")));
+	TEST_CHECK(state.lookup_timed_out(timed_out_generation));
+	TEST_CHECK(state.complete);
+	TEST_CHECK(!state.pending);
+	TEST_CHECK(!state.discovery.valid);
+	TEST_CHECK(state.generation != timed_out_generation);
+	TEST_CHECK(aux::is_global(addr("8.8.8.8"), state.discovery));
+	TEST_CHECK(!aux::is_global(addr("2606:4700:4700::1111"), state.discovery));
+	TEST_CHECK(state.is_peer_address_global(addr("8.8.8.8")));
+	TEST_CHECK(!state.is_peer_address_global(addr("2606:4700:4700::1111")));
+
+	aux::nat64_discovery_result late_success;
+	late_success.valid = true;
+	TEST_CHECK(!state.lookup_completed(timed_out_generation, std::move(late_success)));
+	TEST_CHECK(!state.discovery.valid);
+
+	state.reset();
+	std::uint64_t const completed_generation = state.start_lookup();
+	std::vector<address> const answers{
+		addr("2001:4860:abcd:ef01::c000:aa"),
+		addr("2001:4860:abcd:ef01::c000:ab"),
+	};
+	aux::nat64_discovery_result success = aux::discover_nat64_prefixes(answers);
+	TEST_CHECK(success.valid);
+	TEST_CHECK(state.lookup_completed(completed_generation, std::move(success)));
+	TEST_CHECK(state.discovery.valid);
+	TEST_CHECK(state.is_peer_address_global(addr("2606:4700:4700::1111")));
+	TEST_CHECK(!state.is_peer_address_global(addr("2001:4860:abcd:ef01::a00:1")));
+	TEST_CHECK(state.is_peer_address_global(addr("2001:4860:abcd:ef01::808:808")));
+	TEST_CHECK(!state.lookup_timed_out(completed_generation));
+
+	aux::nat64_discovery_state previous_network;
+	std::uint64_t const previous_generation = previous_network.start_lookup();
+	std::vector<address> const previous_answers{
+		addr("64:ff9b::c000:aa"),
+		addr("64:ff9b::c000:ab"),
+	};
+	TEST_CHECK(previous_network.lookup_completed(previous_generation
+		, aux::discover_nat64_prefixes(previous_answers)));
+	address const reclassified = addr("2001:4860:abcd:ef01::a00:1");
+	TEST_CHECK(previous_network.is_peer_address_global(reclassified));
+	TEST_CHECK(!state.is_peer_address_global(reclassified));
+}
