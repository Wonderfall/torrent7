+		dht_state state;
+		bool sent = false;
+		dht_tracker::send_fun_t const send = [&sent](aux::listen_socket_handle const&,
+			udp::endpoint const&, span<char const>, error_code&,
+			aux::udp_send_flags_t) { sent = true; };
+		dht_tracker dht(&observer, ios, send, sett, cnt, *dht_storage, std::move(state));
+		auto ls = dummy_listen_socket(udp::endpoint(addr("10.0.0.1"), 6881));
+		aux::listen_socket_handle const handle(ls);
+		dht.new_socket(handle);
+
+		entry e;
+		e["y"] = "q";
+		e["q"] = "ping";
+		e["t"] = "aa";
+		e["a"]["id"] = std::string(20, 'a');
+		std::vector<char> buf;
+		bencode(std::back_inserter(buf), e);
+
+		std::array<udp::endpoint, 3> const blocked_sources = {{
+			udp::endpoint(addr("10.0.0.1"), 4),
+			udp::endpoint(addr("::ffff:10.0.0.1"), 4),
+			udp::endpoint(addr("2001:4860:abcd:ef01::a00:1"), 4),
+		}};
+		for (auto const& source : blocked_sources)
+		{
+			std::int64_t const dropped_before = cnt[counters::dht_messages_in_dropped];
+			dht.incoming_packet(handle, source, {buf.data(), int(buf.size())});
+			TEST_EQUAL(cnt[counters::dht_messages_in_dropped], dropped_before + 1);
+			TEST_EQUAL(sent, false);
+		}
+
+		dht.incoming_packet(handle, udp::endpoint(addr("8.8.8.8"), 4)
+			, {buf.data(), int(buf.size())});
+		TEST_EQUAL(sent, true);
+	}
+
+	// Session/DNS router contacts and direct node additions share the same
+	// policy before they can enter a routing table or trigger a query.
+	{
+		dht_test_setup t(udp::endpoint(rand_v4(), 20));
+		enforce_dht_global_addresses(t.observer);
+		t.dht_node.add_router_node(udp::endpoint(addr("192.168.0.1"), 6881));
+		TEST_CHECK(t.dht_node.m_table.begin() == t.dht_node.m_table.end());
+		t.dht_node.add_router_node(udp::endpoint(addr("8.8.8.8"), 6881));
+		TEST_EQUAL(std::distance(t.dht_node.m_table.begin(), t.dht_node.m_table.end()), 1);
+
+		g_sent_packets.clear();
+		t.dht_node.add_node(udp::endpoint(addr("192.168.0.1"), 6881));
+		TEST_CHECK(g_sent_packets.empty());
+		t.dht_node.add_node(udp::endpoint(addr("8.8.4.4"), 6881));
+		TEST_EQUAL(g_sent_packets.size(), 1);
+	}
+
+	// Persisted bootstrap contacts are filtered before being scheduled.
+	{
+		dht_test_setup t(udp::endpoint(rand_v4(), 20));
+		enforce_dht_global_addresses(t.observer);
+		std::vector<udp::endpoint> const nodes = {
+			udp::endpoint(addr("169.254.1.1"), 6881),
+			udp::endpoint(addr("1.1.1.1"), 6881),
+		};
+		g_sent_packets.clear();
+		t.dht_node.bootstrap(nodes, std::bind(&nop_node));
+		TEST_EQUAL(g_sent_packets.size(), 1);
+		TEST_CHECK(find_packet(nodes[1]) != g_sent_packets.end());
+	}
+
+	// Nodes learned from responses are filtered before traversal and routing.
+	{
+		dht_test_setup t(udp::endpoint(rand_v4(), 20));
+		enforce_dht_global_addresses(t.observer);
+		auto algo = std::make_shared<global_policy_test_algo>(t.dht_node, t.dht_node.nid());
+		algo->traverse(generate_random_id(), udp::endpoint(addr("192.0.2.1"), 6881));
+		TEST_CHECK(algo->results().empty());
+		algo->traverse(generate_random_id(), udp::endpoint(addr("9.9.9.9"), 6881));
+		TEST_EQUAL(algo->results().size(), 1);
+		algo->done();
+	}
+
+	// Peer endpoints returned by get_peers are filtered before the torrent
+	// callback sees them, including mapped and NAT64 representations.
+	{
+		dht_test_setup t(udp::endpoint(rand_v4(), 20));
+		enforce_dht_global_addresses(t.observer);
+		std::vector<tcp::endpoint> accepted;
+		auto lookup = std::make_shared<dht::get_peers>(t.dht_node, generate_random_id()
+			, [&accepted](std::vector<tcp::endpoint> const& peers) { accepted = peers; }
+			, find_data::nodes_callback{}, false);
+		lookup->got_peers({
+			tcp::endpoint(addr("8.8.8.8"), 1),
+			tcp::endpoint(addr("10.0.0.1"), 2),
+			tcp::endpoint(addr("::ffff:10.0.0.1"), 3),
+			tcp::endpoint(addr("2001:4860:abcd:ef01::a00:1"), 4),
+			tcp::endpoint(addr("2001:4860:abcd:ef01::808:808"), 5),
+			tcp::endpoint(addr("2001:db8::1"), 6),
+		});
+		TEST_EQUAL(accepted.size(), 2);
+		TEST_EQUAL(accepted[0], tcp::endpoint(addr("8.8.8.8"), 1));
+		TEST_EQUAL(accepted[1]
+			, tcp::endpoint(addr("2001:4860:abcd:ef01::808:808"), 5));
+	}
+}
