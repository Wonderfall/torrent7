+TORRENT_TEST(trackers_restart_after_address_policy_generation_change)
+{
+	io_context ios;
+	aux::session_settings sett;
+	sett.set_bool(settings_pack::ssrf_mitigation, true);
+	scripted_resolver resolver{ios};
+	resolver.results["private-http.test"] = {make_address("10.0.0.20")};
+	resolver.results["private-udp.test"] = {make_address("172.16.0.20")};
+	resolver.stalled.insert("private-http.test");
+	resolver.stalled.insert("private-udp.test");
+	tracker_manager_handler h{ios, sett, resolver};
+	auto const socket = internet_socket_v4();
+	auto http_callback = std::make_shared<ws_request_callback>();
+	auto udp_callback = std::make_shared<ws_request_callback>();
+
+	h.m_tracker_manager.queue_request(ios
+		, tracker_request_for("http://private-http.test:8080/announce", socket)
+		, sett, http_callback);
+	h.m_tracker_manager.queue_request(ios
+		, tracker_request_for("udp://private-udp.test:8080/announce", socket)
+		, sett, udp_callback);
+	ios.poll();
+
+	TEST_EQUAL(std::count(resolver.lookups.begin(), resolver.lookups.end()
+		, "private-http.test"), 1);
+	TEST_EQUAL(std::count(resolver.lookups.begin(), resolver.lookups.end()
+		, "private-udp.test"), 1);
+
+	// Resetting the session policy must silently retire both in-flight DNS
+	// generations. Their eventual callbacks cannot complete either request.
+	h.begin_address_policy();
+	resolver.stalled.clear();
+	resolver.complete_stalled();
+	ios.restart();
+	ios.poll();
+	TEST_EQUAL(http_callback->error_count, 0);
+	TEST_EQUAL(udp_callback->error_count, 0);
+
+	// Completing the new policy generation restarts DNS from scratch. The
+	// private answers are then rejected for the real reason, exactly once.
+	h.complete_address_policy();
+	ios.restart();
+	ios.run();
+
+	TEST_EQUAL(std::count(resolver.lookups.begin(), resolver.lookups.end()
+		, "private-http.test"), 2);
+	TEST_EQUAL(std::count(resolver.lookups.begin(), resolver.lookups.end()
+		, "private-udp.test"), 2);
+	TEST_EQUAL(http_callback->error_count, 1);
+	TEST_EQUAL(http_callback->last_error, error_code(errors::ssrf_mitigation));
+	TEST_EQUAL(udp_callback->error_count, 1);
+	TEST_EQUAL(udp_callback->last_error, error_code(errors::ssrf_mitigation));
+}
