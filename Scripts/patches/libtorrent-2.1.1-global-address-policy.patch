+TORRENT_TEST(trackers_wait_for_session_address_policy)
+{
+	io_context ios;
+	aux::session_settings sett;
+	sett.set_bool(settings_pack::ssrf_mitigation, true);
+	scripted_resolver resolver{ios};
+	resolver.results["private-http.test"] = {make_address("fd00::20")};
+	resolver.results["private-udp.test"] = {make_address("10.0.0.20")};
