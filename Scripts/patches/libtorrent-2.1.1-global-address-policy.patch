 	void http_tracker_connection::start()
 	{
+		aux::session_settings const& settings = m_man.settings();
+		int const timeout = tracker_req().event == event_t::stopped
+			? settings.get_int(settings_pack::stop_tracker_timeout)
+			: settings.get_int(settings_pack::tracker_completion_timeout);
+		m_operation_deadline = clock_type::now() + seconds(timeout);
+		if (!settings.get_bool(settings_pack::ssrf_mitigation))
+		{
+			start_request();
+			return;
+		}
+
+		std::string protocol;
+		error_code ec;
+		std::tie(protocol, std::ignore, std::ignore, std::ignore, std::ignore)
+			= parse_url_components(tracker_req().url, ec);
+		if (ec)
+		{
+			fail(ec, operation_t::parse_address);
+			return;
+		}
+
+#if TORRENT_USE_I2P
+		if (is_i2p_url(tracker_req().url))
+		{
+			start_request();
+			return;
+		}
+#endif
+
+		aux::proxy_settings const ps(settings);
+		if (string_equal_no_case(protocol, "http") && ps.proxy_tracker_connections
+			&& (ps.type == settings_pack::http
+				|| ps.type == settings_pack::http_pw))
+		{
+			// A plaintext HTTP proxy resolves the absolute-form request target
+			// independently. The http_connection API cannot pin that target to a
+			// locally vetted address, so reject this configuration rather than
+			// allowing a proxy-side DNS rebinding or private-network request.
+			fail(errors::ssrf_mitigation, operation_t::bittorrent);
+			return;
+		}
+
+		if (m_man.address_policy().complete)
+		{
+			start_request();
+			return;
+		}
+
+		wait_for_address_policy();
+	}
+
+	void http_tracker_connection::wait_for_address_policy()
+	{
+		if (m_address_policy_pending || cancelled()) return;
+
+		++m_request_generation;
+		if (m_tracker_connection)
