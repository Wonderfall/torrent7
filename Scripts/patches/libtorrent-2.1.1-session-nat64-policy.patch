+	void peer_list::invalidate_global_address_policy(torrent_state* state)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		INVARIANT_CHECK;
+
+		for (auto i = m_peers.begin(); i != m_peers.end();)
+		{
+			torrent_peer* const peer = *i;
+			if (!peer->address().is_v6()
+				|| !peer_source_requires_global_address(peer->peer_source())
+				|| peer == m_locked_peer)
+			{
+				++i;
+				continue;
+			}
+
+			int const current = int(i - m_peers.begin());
+			if (peer->connection)
+			{
+				std::size_t const count = m_peers.size();
+				peer->connection->disconnect(errors::ssrf_mitigation
+					, operation_t::bittorrent);
+				if (m_peers.size() < count)
+				{
+					i = m_peers.begin() + current;
+					continue;
+				}
+				TORRENT_ASSERT((*i)->connection == nullptr
+					|| (*i)->connection->peer_info_struct() == nullptr);
+			}
+
+			erase_peer(i, state);
+			i = m_peers.begin() + current;
+		}
+	}
+
