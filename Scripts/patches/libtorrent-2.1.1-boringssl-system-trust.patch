+	bool append_certificate(CFMutableArrayRef certificates, CRYPTO_BUFFER const* buffer)
+	{
+		auto const size = CRYPTO_BUFFER_len(buffer);
+		if (size == 0 || size > max_certificate_size
+			|| size > static_cast<std::size_t>(std::numeric_limits<CFIndex>::max()))
+			return false;
+
+		cf_handle<CFDataRef> const data(CFDataCreate(kCFAllocatorDefault
+			, CRYPTO_BUFFER_data(buffer), static_cast<CFIndex>(size)));
+		if (!data) return false;
+
+		cf_handle<SecCertificateRef> const certificate(
+			SecCertificateCreateWithData(kCFAllocatorDefault, data.get()));
+		if (!certificate) return false;
+
+		CFArrayAppendValue(certificates, certificate.get());
+		return true;
+	}
+
+	ssl_verify_result_t verify_with_system_trust(SSL* stream, std::uint8_t* out_alert)
+	{
+		*out_alert = SSL_AD_BAD_CERTIFICATE;
+		auto const index = expected_hostname_index();
+		if (index < 0)
+		{
+			*out_alert = SSL_AD_INTERNAL_ERROR;
+			return ssl_verify_invalid;
+		}
+
+		auto const* hostname = static_cast<std::string const*>(
+			SSL_get_ex_data(stream, index));
+		if (hostname == nullptr)
+		{
+			*out_alert = SSL_AD_INTERNAL_ERROR;
+			return ssl_verify_invalid;
+		}
+
+		auto const* chain = SSL_get0_peer_certificates(stream);
+		auto const chain_size = chain == nullptr ? 0 : sk_CRYPTO_BUFFER_num(chain);
+		if (chain_size == 0 || chain_size > max_certificate_chain_size) return ssl_verify_invalid;
+
+		cf_handle<CFMutableArrayRef> const certificates(CFArrayCreateMutable(
+			kCFAllocatorDefault, static_cast<CFIndex>(chain_size), &kCFTypeArrayCallBacks));
+		if (!certificates)
+		{
+			*out_alert = SSL_AD_INTERNAL_ERROR;
+			return ssl_verify_invalid;
+		}
+
+		for (std::size_t i = 0; i < chain_size; ++i)
+			if (!append_certificate(certificates.get(), sk_CRYPTO_BUFFER_value(chain, i)))
+				return ssl_verify_invalid;
+
+		cf_handle<CFStringRef> const server_name(CFStringCreateWithBytes(
+			kCFAllocatorDefault
+			, reinterpret_cast<UInt8 const*>(hostname->data())
+			, static_cast<CFIndex>(hostname->size())
+			, kCFStringEncodingUTF8
+			, false));
+		if (!server_name) return ssl_verify_invalid;
+
+		cf_handle<SecPolicyRef> const policy(SecPolicyCreateSSL(true, server_name.get()));
+		if (!policy)
+		{
+			*out_alert = SSL_AD_INTERNAL_ERROR;
+			return ssl_verify_invalid;
+		}
+
+		SecTrustRef trust_value = nullptr;
+		if (SecTrustCreateWithCertificates(certificates.get(), policy.get(), &trust_value)
+			!= errSecSuccess)
+		{
+			*out_alert = SSL_AD_INTERNAL_ERROR;
+			return ssl_verify_invalid;
+		}
+		cf_handle<SecTrustRef> const trust(trust_value);
+		if (SecTrustSetNetworkFetchAllowed(trust.get(), false) != errSecSuccess)
+		{
+			*out_alert = SSL_AD_INTERNAL_ERROR;
+			return ssl_verify_invalid;
+		}
+
+		CFErrorRef trust_error = nullptr;
+		auto const trusted = SecTrustEvaluateWithError(trust.get(), &trust_error);
+		cf_handle<CFErrorRef> const error(trust_error);
+		return trusted ? ssl_verify_ok : ssl_verify_invalid;
+	}
