+TORRENT_TEST(boringssl_client_policy)
+{
+	auto context = aux::ssl::make_client_context(
+		aux::ssl::client_context_authentication::system_trust);
+	auto* const native_context = context.native_handle();
+	TEST_EQUAL(SSL_CTX_get_min_proto_version(native_context), TLS1_2_VERSION);
+	TEST_EQUAL(SSL_CTX_get_max_cert_list(native_context), 4 * 1024 * 1024);
+	TEST_EQUAL(SSL_CTX_get_verify_mode(native_context), SSL_VERIFY_PEER);
+	auto const expected_ciphers = std::array{
+		"TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256",
+		"TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256",
+		"TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256",
+		"TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256",
+		"TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
+		"TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384"
+	};
+	auto const* ciphers = SSL_CTX_get_ciphers(native_context);
+	TEST_EQUAL(sk_SSL_CIPHER_num(ciphers), expected_ciphers.size());
+	for (std::size_t i = 0; i < expected_ciphers.size(); ++i)
+	{
+		auto const* cipher = sk_SSL_CIPHER_value(ciphers, i);
+		TEST_EQUAL(std::string(SSL_CIPHER_standard_name(cipher)), expected_ciphers[i]);
+		TEST_CHECK(SSL_CIPHER_is_aead(cipher) == 1);
+		TEST_CHECK(std::string(SSL_CIPHER_get_kx_name(cipher)).starts_with("ECDHE_"));
+	}
+
+	std::unique_ptr<SSL, decltype(&SSL_free)> dns_stream(SSL_new(native_context), &SSL_free);
+	TEST_CHECK(dns_stream != nullptr);
+	error_code ec;
+	aux::ssl::set_host_name(dns_stream.get(), "xn--bcher-kva.example", ec);
+	TEST_CHECK(!ec);
+	TEST_EQUAL(std::string(SSL_get_servername(dns_stream.get(), TLSEXT_NAMETYPE_host_name))
+		, "xn--bcher-kva.example");
+
+	std::unique_ptr<SSL, decltype(&SSL_free)> ip_stream(SSL_new(native_context), &SSL_free);
+	TEST_CHECK(ip_stream != nullptr);
+	aux::ssl::set_host_name(ip_stream.get(), "127.0.0.1", ec);
+	TEST_CHECK(!ec);
+	TEST_CHECK(SSL_get_servername(ip_stream.get(), TLSEXT_NAMETYPE_host_name) == nullptr);
+	aux::ssl::set_host_name(ip_stream.get(), "fe80::1%25en0", ec);
+	TEST_CHECK(!ec);
+	TEST_CHECK(SSL_get_servername(ip_stream.get(), TLSEXT_NAMETYPE_host_name) == nullptr);
+
+	aux::ssl::set_host_name(ip_stream.get(), "", ec);
+	TEST_CHECK(ec == error_code(errors::invalid_hostname));
+	aux::ssl::set_host_name(ip_stream.get(), std::string("valid.example\0.invalid", 22), ec);
+	TEST_CHECK(ec == error_code(errors::invalid_hostname));
+	aux::ssl::set_host_name(ip_stream.get(), "invalid_name.example", ec);
+	TEST_CHECK(ec == error_code(errors::invalid_hostname));
+}
