+	bool valid_dns_name(std::string const& name)
+	{
+		if (name.empty() || name.size() > 253 || name.back() == '.') return false;
+
+		auto const is_alphanumeric = [](char const c)
+		{
+			return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+				|| (c >= '0' && c <= '9');
+		};
+
+		std::size_t label_start = 0;
+		for (std::size_t i = 0; i <= name.size(); ++i)
+		{
+			if (i != name.size() && name[i] != '.') continue;
+
+			auto const label_size = i - label_start;
+			if (label_size == 0 || label_size > 63
+				|| !is_alphanumeric(name[label_start])
+				|| !is_alphanumeric(name[i - 1]))
+				return false;
+
+			for (std::size_t j = label_start; j < i; ++j)
+				if (!is_alphanumeric(name[j]) && name[j] != '-') return false;
+			label_start = i + 1;
+		}
+		return true;
+	}
