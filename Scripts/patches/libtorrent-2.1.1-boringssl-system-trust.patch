+context make_client_context(client_context_authentication const authentication)
+{
+#ifdef OPENSSL_IS_BORINGSSL
+	auto* const native_context = SSL_CTX_new(TLS_with_buffers_method());
+	if (native_context == nullptr) throw_ssl_error();
+	context result(native_context);
+
+	require_ssl_success(SSL_CTX_set_min_proto_version(native_context, TLS1_2_VERSION));
+	require_ssl_success(SSL_CTX_set_strict_cipher_list(native_context, tls12_cipher_list));
+	SSL_CTX_set_early_data_enabled(native_context, 0);
+	SSL_CTX_set_max_cert_list(native_context, max_certificate_list_size);
+
+	auto* const pool = shared_certificate_pool();
+	if (pool == nullptr) throw_ssl_error();
+	SSL_CTX_set1_buffer_pool(native_context, pool);
+
+	SSL_CTX_set_custom_verify(native_context, SSL_VERIFY_PEER
+		, authentication == client_context_authentication::system_trust
+			? &verify_with_system_trust
+			: &accept_certificate);
+	return result;
+#else
+	context result(context::tls_client);
+	error_code ec;
+	result.set_options(no_legacy_tls_versions, ec);
+	if (!ec)
+		result.set_verify_mode(authentication == client_context_authentication::system_trust
+			? context::verify_peer
+			: context::verify_none, ec);
+	if (ec) aux::throw_ex<boost::system::system_error>(ec);
+	return result;
+#endif
+}
