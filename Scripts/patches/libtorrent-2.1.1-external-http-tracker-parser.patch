+			{
+				ec = errors::invalid_peers_entry;
+				return response;
+			}
+			for (int offset = 0; offset < length; offset += 32)
+			{
+				i2p_peer_entry peer;
+				std::memcpy(peer.destination.data(), cursor + offset, 32);
+				response.i2p_peers.push_back(peer);
+			}
+		}
+		else
+#endif
+		{
+			if (!test_valid_compact_peer_list(length, 6))
+			{
+				ec = errors::invalid_peers_entry;
+				return response;
+			}
+			response.peers4.reserve(std::size_t(length / 6));
+			for (int offset = 0; offset < length; offset += 6)
+			{
+				ipv4_peer_entry peer;
+				peer.ip = read_v4_address(cursor).to_bytes();
+				peer.port = read_uint16(cursor);
+				response.peers4.push_back(peer);
+			}
+		}
+	}
+	else if (peers && peers.type() == bdecode_node::list_t)
+	{
+		response.peers.reserve(std::size_t(peers.list_size()));
+		error_code parse_error;
+		for (int index = 0; index < peers.list_size(); ++index)
+		{
+			peer_entry peer;
+			if (!extract_peer_info(peers.list_at(index), peer, parse_error)) continue;
+			response.peers.push_back(peer);
+		}
+		if (response.peers.empty() && parse_error)
+		{
+			ec = parse_error;
+			return response;
+		}
+	}
+	else
+	{
+		peers.clear();
+	}
+
+	bdecode_node peers6 = root.dict_find_string("peers6");
+	if (peers6)
+	{
+		char const* cursor = peers6.string_ptr();
+		int const length = peers6.string_length();
+		if (!test_valid_compact_peer_list(length, 18))
+		{
+			ec = errors::invalid_peers_entry;
+			return response;
+		}
+		response.peers6.reserve(std::size_t(length / 18));
+		for (int offset = 0; offset < length; offset += 18)
+		{
+			ipv6_peer_entry peer;
+			peer.ip = read_v6_address(cursor).to_bytes();
+			peer.port = read_uint16(cursor);
+			response.peers6.push_back(peer);
+		}
+	}
+
+	if (bdecode_node const external_ip = root.dict_find_string("external ip"))
+	{
+		char const* cursor = external_ip.string_ptr();
+		if (external_ip.string_length() == int(address_v4::bytes_type{}.size()))
+			response.external_ip = read_v4_address(cursor);
+		else if (external_ip.string_length() == int(address_v6::bytes_type{}.size()))
+			response.external_ip = read_v6_address(cursor);
+	}
+	return response;
+}
