+bool extract_peer_info(bdecode_node const& info, peer_entry& result, error_code& ec)
+{
+	if (info.type() != bdecode_node::dict_t)
+	{
+		ec = errors::invalid_peer_dict;
+		return false;
+	}
+	bdecode_node value = info.dict_find_string("peer id");
+	if (value && value.string_length() == 20)
+		std::copy(value.string_ptr(), value.string_ptr() + 20, result.pid.begin());
+	else
+		result.pid.clear();
+
+	value = info.dict_find_string("ip");
+	if (!value)
+	{
+		ec = errors::invalid_tracker_response;
+		return false;
+	}
+	result.hostname = value.string_value();
+
+	value = info.dict_find_int("port");
+	if (!value)
+	{
+		ec = errors::invalid_tracker_response;
+		return false;
+	}
+	auto const port = value.int_value();
+	if (port < 0 || port > std::numeric_limits<std::uint16_t>::max())
+	{
+		ec = errors::invalid_tracker_response;
+		return false;
+	}
+	result.port = std::uint16_t(port);
+	return true;
