+All rights reserved.
+
+You may use, distribute and modify this code under the terms of the BSD license,
+see LICENSE file.
+*/
+
+#ifndef TORRENT_TRACKER_RESPONSE_PARSER_HPP
+#define TORRENT_TRACKER_RESPONSE_PARSER_HPP
+
+#include "libtorrent/config.hpp"
+#include "libtorrent/error_code.hpp"
+#include "libtorrent/sha1_hash.hpp"
+#include "libtorrent/span.hpp"
+
+namespace libtorrent::aux {
+
+	struct tracker_response;
+
+	// Parses only the final decompressed bencoded body of an HTTP tracker
+	// response. HTTP framing, decompression, redirects, TLS, and endpoint policy
+	// remain in the native tracker connection.
+	struct TORRENT_EXTRA_EXPORT tracker_response_parser
+	{
+		static constexpr int maximum_http_body_size = 512 * 1024;
+
+		virtual ~tracker_response_parser() = default;
+
+		virtual bool parse_http_response(span<char const> body
+			, bool is_scrape, sha1_hash const& scrape_info_hash
+			, tracker_response& result, error_code& ec) noexcept = 0;
+	};
+
+}
+
+#endif // TORRENT_TRACKER_RESPONSE_PARSER_HPP
