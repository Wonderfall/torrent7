 using namespace lt;
 using namespace lt::aux;
 
+namespace {
+
+#if TORRENT_HAS_BINDTODEVICE
+	struct failing_device_bind_socket
+	{
+		template <typename Option>
+		void set_option(Option const&, error_code& ec)
+		{
+			++set_option_calls;
+			ec = error_code(boost::system::errc::permission_denied, generic_category());
+		}
+
+		void close(error_code& ec)
+		{
+			closed = true;
+			ec = error_code(boost::system::errc::io_error, generic_category());
+		}
+
+		void bind(tcp::endpoint const&, error_code& ec)
+		{
+			++address_bind_calls;
+			ec.clear();
+		}
+
+		int set_option_calls = 0;
+		int address_bind_calls = 0;
+		bool closed = false;
+	};
+
+	template <typename Protocol>
+	void expect_native_device_bind_succeeds(Protocol const protocol)
+	{
+		io_context ios;
+		typename Protocol::socket socket(ios);
+		error_code ec;
+		socket.open(protocol, ec);
+		TEST_CHECK(!ec);
+		bind_device(socket, "lo0", ec);
+		TEST_CHECK(!ec);
+		TEST_CHECK(socket.is_open());
+#if defined SO_BINDTODEVICE
+		std::array<char, IFNAMSIZ + 1> device{};
+		socklen_t size = socklen_t(device.size());
+		int const result = ::getsockopt(socket.native_handle(), SOL_SOCKET
+			, SO_BINDTODEVICE, device.data(), &size);
+		TEST_EQUAL(result, 0);
+		TEST_EQUAL(std::string(device.data()), "lo0");
+#endif
+	}
+
+	void expect_outgoing_device_bind_succeeds(tcp const protocol)
+	{
+		io_context ios;
+		tcp::socket socket(ios);
+		error_code ec;
+		socket.open(protocol, ec);
+		TEST_CHECK(!ec);
+		address const bound = bind_socket_to_device(
+			ios, socket, protocol, "lo0", 0, ec);
+		TEST_CHECK(!ec);
+		TEST_CHECK(bound.is_unspecified());
+		TEST_EQUAL(bound.is_v6(), protocol == tcp::v6());
+		TEST_CHECK(socket.is_open());
+	}
+#endif
+
+}
+
+#if TORRENT_HAS_BINDTODEVICE
+TORRENT_TEST(device_bind_failure_is_terminal)
+{
+	error_code const expected(
+		boost::system::errc::permission_denied, generic_category());
+
+	failing_device_bind_socket direct;
+	error_code ec;
+	bind_device(direct, "lo0", ec);
+	TEST_CHECK(ec == expected);
+	TEST_EQUAL(direct.set_option_calls, 1);
+	TEST_CHECK(direct.closed);
+
+	failing_device_bind_socket outgoing;
+	io_context ios;
+	address const bound = bind_socket_to_device(
+		ios, outgoing, tcp::v4(), "lo0", 0, ec);
+	TEST_CHECK(ec == expected);
+	TEST_CHECK(bound == address_v4::any());
+	TEST_EQUAL(outgoing.set_option_calls, 1);
+	TEST_EQUAL(outgoing.address_bind_calls, 0);
+	TEST_CHECK(outgoing.closed);
+}
+
+TORRENT_TEST(native_device_binding_is_family_safe)
+{
+#if defined SO_BINDTODEVICE
+	bind_to_device const option("lo0");
+	TEST_EQUAL(option.level(tcp::v4()), SOL_SOCKET);
+	TEST_EQUAL(option.name(tcp::v4()), SO_BINDTODEVICE);
+	TEST_EQUAL(option.level(tcp::v6()), SOL_SOCKET);
+	TEST_EQUAL(option.name(tcp::v6()), SO_BINDTODEVICE);
+#endif
+
+	expect_native_device_bind_succeeds(tcp::v4());
+	expect_native_device_bind_succeeds(tcp::v6());
+	expect_native_device_bind_succeeds(udp::v4());
+	expect_native_device_bind_succeeds(udp::v6());
+	expect_outgoing_device_bind_succeeds(tcp::v4());
+	expect_outgoing_device_bind_succeeds(tcp::v6());
+}
+#endif
+
