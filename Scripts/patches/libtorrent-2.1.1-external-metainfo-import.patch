+see LICENSE file.
+*/
+
+#ifndef TORRENT_AUX_PREPARSED_METAINFO_HPP_INCLUDED
+#define TORRENT_AUX_PREPARSED_METAINFO_HPP_INCLUDED
+
+#include "libtorrent/config.hpp"
+#include "libtorrent/error_code.hpp"
+#include "libtorrent/file_storage.hpp"
+#include "libtorrent/fwd.hpp"
+#include "libtorrent/info_hash.hpp"
+#include "libtorrent/span.hpp"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+namespace libtorrent::aux {
+
+	// Narrow input for constructing torrent_info after an external parser has
+	// validated the info dictionary. Paths are already joined storage paths.
+	// A non-negative pieces_root_offset addresses 32 bytes in info_section.
+	struct preparsed_metainfo_file
+	{
+		std::string path;
+		std::int64_t size = 0;
+		file_flags_t flags{};
+		std::int32_t pieces_root_offset = -1;
+	};
+
+	struct preparsed_metainfo
+	{
+		span<char const> info_section;
+		span<preparsed_metainfo_file const> files;
+		info_hash_t expected_info_hashes;
+		std::string name;
+		int piece_length = 0;
+		std::int32_t piece_hashes_offset = -1;
+		std::int32_t piece_hashes_size = 0;
+		bool multifile = false;
+		bool private_torrent = false;
+	};
+
+	// This importer does not decode info_section. It copies the exact bytes,
+	// recomputes identity, derives file offsets and piece counts, and commits a
+	// fully populated torrent_info only after all supplied semantics agree.
+	TORRENT_EXTRA_EXPORT std::shared_ptr<torrent_info> import_preparsed_metainfo(
+		preparsed_metainfo const& input, error_code& ec);
+
+}
+
+#endif // TORRENT_AUX_PREPARSED_METAINFO_HPP_INCLUDED
