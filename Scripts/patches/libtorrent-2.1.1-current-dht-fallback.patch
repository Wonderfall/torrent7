+TORRENT_TEST(dht_fallback_tracks_current_endpoint_health)
+{
+	tracker_list trackers;
+	libtorrent::info_hash_t const info_hashes(
+		libtorrent::sha1_hash("01234567890123456789"));
+	TEST_CHECK(trackers.all_usable_trackers_failed(info_hashes, false, false));
+
+	trackers.add_tracker(announce_entry("http://tracker-one.example/announce"));
+	TEST_CHECK(!trackers.all_usable_trackers_failed(info_hashes, false, false));
+
+	auto& first = *trackers.begin();
+	first.endpoints.emplace_back(listen_socket_handle{}, false);
+	auto& first_state = first.endpoints.front().info_hashes[libtorrent::protocol_version::V1];
+	TEST_CHECK(!trackers.all_usable_trackers_failed(info_hashes, false, false));
+
+	first_state.fails = 1;
+	first_state.updating = true;
+	// Retrying an already failed endpoint must not suspend fallback or cause a
+	// new transition when that retry fails again.
+	TEST_CHECK(trackers.all_usable_trackers_failed(info_hashes, false, false));
+	first_state.updating = false;
+	TEST_CHECK(trackers.all_usable_trackers_failed(info_hashes, false, false));
+
+	trackers.add_tracker(announce_entry("http://tracker-two.example/announce"));
+	auto& second = *std::next(trackers.begin());
+	second.endpoints.emplace_back(listen_socket_handle{}, false);
+	auto& second_state = second.endpoints.front().info_hashes[libtorrent::protocol_version::V1];
+	TEST_CHECK(!trackers.all_usable_trackers_failed(info_hashes, false, false));
+
+	second_state.fails = 1;
+	TEST_CHECK(trackers.all_usable_trackers_failed(info_hashes, false, false));
+
+	// A successful response, including one with no peers, resets the current
+	// endpoint health and suppresses future fallback lookups.
+	first_state.fails = 0;
+	TEST_CHECK(!trackers.all_usable_trackers_failed(info_hashes, false, false));
+	first_state.fails = 1;
+	first.endpoints.front().enabled = false;
+	TEST_CHECK(trackers.all_usable_trackers_failed(info_hashes, false, false));
+}
