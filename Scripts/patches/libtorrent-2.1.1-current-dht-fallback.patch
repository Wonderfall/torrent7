 {
-	return std::any_of(m_trackers.begin(), m_trackers.end()
-		, [](aux::announce_entry const& t) { return t.verified; });
+#if !TORRENT_USE_I2P
+	TORRENT_UNUSED(torrent_is_i2p);
+	TORRENT_UNUSED(allow_i2p_mixed);
+#endif
+	for (aux::announce_entry const& tracker : m_trackers)
+	{
+#if TORRENT_USE_I2P
+		if (!tracker.i2p && torrent_is_i2p && !allow_i2p_mixed) continue;
+#endif
+		// A compatible tracker without endpoints has not had a chance to run
+		// yet. Do not let the initial DHT timer race the first tracker request.
+		if (tracker.endpoints.empty()) return false;
+
+		for (aux::announce_endpoint const& endpoint : tracker.endpoints)
+		{
+			if (!endpoint.enabled) continue;
+			for (protocol_version const version : all_versions)
+			{
+				if (!info_hashes.has(version)) continue;
+				auto const& state = endpoint.info_hashes[version];
+				// Retrying a failed endpoint does not make it healthy again. Keep
+				// fallback active until a successful response resets its fail count.
+				if (state.is_working()) return false;
+			}
+		}
+	}
+	return true;
