+void reply(tracker_session::request const& request, aux::tracker_response const& response)
+{
+	auto const callback = request.callback.lock();
+	TEST_CHECK(callback);
+	if (callback) callback->tracker_response(request.value, make_address("8.8.4.4"), {}, response);
+}
+}
+
+TORRENT_TEST(private_tracker_failover_discards_late_response_and_peer_dns)
+{
+	fixture f;
+	f.target->announce_with_tracker();
+	TEST_EQUAL(f.ses.requests.size(), 1);
+	if (f.ses.requests.empty()) return;
+	auto const first = f.ses.requests.front();
+	TEST_EQUAL(first.value.url, "https://tracker-a.test/announce");
+	aux::tracker_response a;
+	a.peers4.push_back({make_address_v4("8.8.8.8").to_bytes(), 49000});
+	a.peers.push_back({"delayed-peer.test", {}, 49001});
+	a.external_ip = make_address("1.2.3.4");
+	reply(first, a);
+	TEST_EQUAL(f.target->num_known_peers(), 1);
+	TEST_EQUAL(f.ses.dns.requests.size(), 1);
+	f.target->force_tracker_request_url(aux::time_now() - seconds(1), first.value.url
+		, torrent_handle::ignore_min_interval | torrent_handle::high_priority);
+	TEST_EQUAL(f.ses.requests.size(), 2);
+	if (f.ses.requests.size() != 2) return;
+	auto const retry = f.ses.requests.back();
+	// A real timeout drives tracker deprioritization, authorization of B, and
+	// peer cleanup through the production torrent callback and announce path.
+	f.target->tracker_request_error(retry.value, boost::asio::error::timed_out
+		, operation_t::sock_read, "controlled timeout", seconds32(0));
+	TEST_EQUAL(f.ses.requests.size(), 3);
+	if (f.ses.requests.size() != 3) return;
+	auto const next = f.ses.requests.back();
+	TEST_EQUAL(next.value.url, "https://tracker-b.test/announce");
+	TEST_CHECK(next.value.private_tracker_generation != retry.value.private_tracker_generation);
+	TEST_EQUAL(next.value.tracker_generation, retry.value.tracker_generation);
+	TEST_EQUAL(f.target->num_known_peers(), 0);
+
+	f.ses.dns.complete({make_address("9.9.9.9")});
+	reply(retry, a);
+	f.target->tracker_request_error(retry.value, boost::asio::error::timed_out
+		, operation_t::sock_read, "late timeout", seconds32(0));
+	TEST_EQUAL(f.target->num_known_peers(), 0);
+	TEST_EQUAL(f.ses.external_votes.size(), 1);
+	TEST_EQUAL(f.ses.requests.size(), 3);
+	TEST_CHECK(f.ses.dns.requests.empty());
+
+	aux::tracker_response b;
+	b.peers4.push_back({make_address_v4("1.1.1.1").to_bytes(), 49002});
+	b.external_ip = make_address("5.6.7.8");
+	reply(next, b);
+	TEST_EQUAL(f.target->num_known_peers(), 1);
+	TEST_EQUAL(f.ses.external_votes.size(), 2);
+	TEST_EQUAL(f.ses.external_votes.back(), b.external_ip);
+	reply(retry, a);
+	TEST_EQUAL(f.target->num_known_peers(), 1);
+	TEST_CHECK(f.ses.dns.requests.empty());
+	TEST_EQUAL(f.ses.external_votes.size(), 2);
+}
