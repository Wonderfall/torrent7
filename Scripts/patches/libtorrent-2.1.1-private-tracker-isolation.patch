+TORRENT_TEST(private_tracker_generation_isolation)
+{
+	aux::private_tracker_state state;
+	std::uint64_t first_generation = 0;
+	TEST_CHECK(state.authorize("https://tracker-a.example/announce", true, false
+		, first_generation) == aux::private_tracker_request_result::current);
+	TEST_CHECK(first_generation != 0);
+	TEST_CHECK(state.accepts("https://tracker-a.example/announce"
+		, first_generation));
+
+	std::uint64_t rejected_generation = 0;
+	TEST_CHECK(state.authorize("https://tracker-b.example/announce", true, false
+		, rejected_generation) == aux::private_tracker_request_result::rejected);
+	TEST_EQUAL(rejected_generation, 0);
+	TEST_CHECK(!state.mark_failed("https://tracker-a.example/announce"
+		, first_generation + 1));
+	TEST_CHECK(state.mark_failed("https://tracker-a.example/announce"
+		, first_generation));
+	TEST_CHECK(!state.accepts("https://tracker-a.example/announce"
+		, first_generation));
+
+	std::uint64_t second_generation = 0;
+	TEST_CHECK(state.authorize("https://tracker-b.example/announce", true, false
+		, second_generation) == aux::private_tracker_request_result::switched);
+	TEST_CHECK(second_generation != first_generation);
+	TEST_CHECK(!state.accepts("https://tracker-a.example/announce"
+		, first_generation));
+	TEST_CHECK(state.accepts("https://tracker-b.example/announce"
+		, second_generation));
+	TEST_CHECK(!state.reset_for_policy_change(false));
+	TEST_CHECK(state.accepts("https://tracker-b.example/announce"
+		, second_generation));
+
+	aux::announce_infohash request_state;
+	request_state.begin_tracker_request(first_generation);
+	request_state.begin_tracker_request(second_generation);
+	TEST_CHECK(!request_state.complete_tracker_request(first_generation));
+	TEST_CHECK(request_state.updating);
+	TEST_EQUAL(request_state.private_tracker_generation, second_generation);
+	TEST_CHECK(request_state.complete_tracker_request(second_generation));
+	TEST_CHECK(!request_state.updating);
+	TEST_EQUAL(request_state.private_tracker_generation, 0);
+
+	std::uint64_t stopped_generation = 0;
+	TEST_CHECK(state.authorize("https://tracker-a.example/announce", true, true
+		, stopped_generation) == aux::private_tracker_request_result::rejected);
+	TEST_CHECK(state.authorize("https://tracker-b.example/announce", true, true
+		, stopped_generation) == aux::private_tracker_request_result::current);
+	TEST_EQUAL(stopped_generation, second_generation);
+
+	TEST_CHECK(state.reset_for_policy_change(true));
+	TEST_CHECK(!state.accepts("https://tracker-b.example/announce"
+		, second_generation));
+	std::uint64_t replacement_generation = 0;
+	TEST_CHECK(state.authorize("https://tracker-c.example/announce", false, false
+		, replacement_generation) == aux::private_tracker_request_result::current);
+	TEST_CHECK(replacement_generation != second_generation);
+	std::uint64_t removed_generation = 0;
+	TEST_CHECK(state.authorize("https://tracker-d.example/announce", false, false
+		, removed_generation) == aux::private_tracker_request_result::switched);
+	TEST_CHECK(removed_generation != replacement_generation);
+}
