+	scripted_resolver resolver{ios};
+	resolver.results["http-v6.test"] = {make_address("2001:4860:4860::8888")};
+	resolver.results["udp-v6.test"] = {make_address("2606:4700:4700::1111")};
+	tracker_manager_handler h{ios, sett, resolver};
+	h.begin_address_policy();
+	auto socket = std::make_shared<aux::listen_socket_t>();
+	socket->local_endpoint = tcp::endpoint(address_v6::any(), 6881);
+	auto http_callback = std::make_shared<ws_request_callback>();
+	auto udp_callback = std::make_shared<ws_request_callback>();
+
+	h.m_tracker_manager.queue_request(ios
+		, tracker_request_for("http://http-v6.test:8080/announce", socket)
+		, sett, http_callback);
+	h.m_tracker_manager.queue_request(ios
+		, tracker_request_for("udp://udp-v6.test:8080/announce", socket)
+		, sett, udp_callback);
+	ios.poll();
+	TEST_EQUAL(http_callback->error_count, 0);
