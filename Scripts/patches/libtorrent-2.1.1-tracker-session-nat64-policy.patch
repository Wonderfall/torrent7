+	void tracker_manager::address_policy_updated()
+	{
+		TORRENT_ASSERT(is_single_thread());
+		if (!m_address_policy.complete) return;
+
+		// Keep each connection alive while its readiness callback runs. Starting
+		// a request may post a terminal result, but never leaves an iterator into
+		// the manager containers exposed to that re-entrant lifecycle.
+		auto const http_connections = m_http_conns;
+		std::vector<std::shared_ptr<udp_tracker_connection>> udp_connections;
+		udp_connections.reserve(m_udp_conns.size());
+		for (auto const& connection : m_udp_conns)
+			udp_connections.push_back(connection.second);
+
+		for (auto const& connection : http_connections)
+			connection->on_address_policy_updated();
+		for (auto const& connection : udp_connections)
+			connection->on_address_policy_updated();
+	}
