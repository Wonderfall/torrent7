--- /dev/null
+++ b/include/libtorrent/aux_/peer_message_parser.hpp
@@ -0,0 +1,103 @@
+/*
+
+Copyright (c) 2026, Torrent7 contributors
+All rights reserved.
+
+You may use, distribute and modify this code under the terms of the BSD license,
+see LICENSE file.
+*/
+
+#ifndef TORRENT_PEER_MESSAGE_PARSER_HPP
+#define TORRENT_PEER_MESSAGE_PARSER_HPP
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "libtorrent/config.hpp"
+#include "libtorrent/error_code.hpp"
+#include "libtorrent/pex_flags.hpp"
+#include "libtorrent/socket.hpp"
+#include "libtorrent/span.hpp"
+
+namespace libtorrent::aux {
+
+	struct extension_handshake
+	{
+		// -1 means absent from this additive update. 0 disables an
+		// extension, and positive values are peer-local message IDs.
+		int ut_metadata_id = -1;
+		int ut_pex_id = -1;
+		int upload_only_id = -1;
+		int holepunch_id = -1;
+		int dont_have_id = -1;
+
+		std::optional<int> metadata_size;
+		std::optional<int> listen_port;
+		std::optional<int> last_seen_complete;
+		std::optional<int> request_queue_limit;
+		std::optional<std::string> client_version;
+		std::optional<address> external_address;
+		std::optional<bool> upload_only;
+	};
+
+	enum class ut_metadata_message_type : std::uint8_t
+	{
+		request = 0,
+		piece = 1,
+		dont_have = 2,
+		unknown = 255,
+	};
+
+	struct ut_metadata_message
+	{
+		ut_metadata_message_type type = ut_metadata_message_type::unknown;
+		std::int64_t raw_type = 0;
+		int piece = 0;
+		int total_size = 0;
+		int payload_offset = 0;
+		int payload_size = 0;
+	};
+
+	enum class peer_exchange_action : std::uint8_t
+	{
+		add = 1,
+		drop = 2,
+	};
+
+	struct peer_exchange_contact
+	{
+		tcp::endpoint endpoint;
+		peer_exchange_action action = peer_exchange_action::add;
+		pex_flags_t flags{};
+	};
+
+	struct peer_exchange_message
+	{
+		std::vector<peer_exchange_contact> contacts;
+		int added_count = 0;
+		int dropped_count = 0;
+	};
+
+	// Parses the bounded bencoded control messages carried by the extension
+	// protocol. Implementations are supplied by the embedding application so
+	// peer-controlled dictionaries do not enter libtorrent's native bdecoder.
+	struct TORRENT_EXTRA_EXPORT peer_message_parser
+	{
+		virtual ~peer_message_parser() = default;
+
+		virtual bool parse_extension_handshake(span<char const> message
+			, extension_handshake& result, error_code& ec) noexcept = 0;
+
+		virtual bool parse_ut_metadata(span<char const> message
+			, ut_metadata_message& result, error_code& ec) noexcept = 0;
+
+		virtual bool parse_ut_pex(span<char const> message
+			, peer_exchange_message& result, error_code& ec) noexcept = 0;
+	};
+
+}
+
+#endif // TORRENT_PEER_MESSAGE_PARSER_HPP
