+TORRENT_TEST(stale_public_tracker_response_after_replacement)
+{
+	int const http_port = start_web_server();
+
+	settings_pack pack = settings();
+	pack.set_int(settings_pack::tracker_completion_timeout, 3);
+	pack.set_int(settings_pack::tracker_receive_timeout, 2);
+	pack.set_str(settings_pack::listen_interfaces, test_listen_interface());
+	lt::session ses(pack);
+
+	error_code ec;
+	remove_all("tmp_stale_tracker", ec);
+	create_directory("tmp_stale_tracker", ec);
+	ofstream file(combine_path("tmp_stale_tracker", "temporary").c_str());
+	add_torrent_params addp = ::create_torrent(&file, "temporary", 16 * 1024, 13, false);
+	file.close();
+
+	char tracker_url[200];
+	std::snprintf(tracker_url, sizeof(tracker_url)
+		, "http://127.0.0.1:%d/announce_delayed", http_port);
+	addp.trackers.push_back(tracker_url);
+	addp.flags &= ~torrent_flags::paused;
+	addp.flags &= ~torrent_flags::auto_managed;
+	addp.flags |= torrent_flags::seed_mode;
+	addp.save_path = "tmp_stale_tracker";
+	torrent_handle h = ses.add_torrent(addp);
+
+	TEST_CHECK(wait_for_alert(ses, tracker_announce_alert::alert_type, "s") != nullptr);
+	h.replace_trackers({announce_entry{"https://replacement.invalid/announce"}});
+	std::this_thread::sleep_for(1500ms);
+
+	bool stale_reply = false;
+	bool stale_external_ip = false;
+	std::vector<alert*> alerts;
+	ses.pop_alerts(&alerts);
+	for (alert const* a : alerts)
+	{
+		stale_reply |= alert_cast<tracker_reply_alert>(a) != nullptr;
+		auto const* external = alert_cast<external_ip_alert>(a);
+		stale_external_ip |= external != nullptr
+			&& external->external_address == addr4("1.2.3.4");
+	}
+	TEST_CHECK(!stale_reply);
+	TEST_CHECK(!stale_external_ip);
+
+	h.save_resume_data();
+	auto const* saved_alert = wait_for_alert(ses, save_resume_data_alert::alert_type, "s");
+	auto const* saved = alert_cast<save_resume_data_alert>(saved_alert);
+	TEST_CHECK(saved != nullptr);
+	if (saved != nullptr) TEST_CHECK(saved->params.peers.empty());
+
+	stop_web_server();
+}
