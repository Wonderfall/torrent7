+struct test_payload_file_provider final : aux::payload_file_provider
+{
+	explicit test_payload_file_provider(std::vector<std::string> files)
+		: paths(std::move(files))
+	{}
+
+	int open_payload(file_index_t const file, bool const write, error_code& ec) override
+	{
+		int const index = static_cast<int>(file);
+		if (index < 0 || index >= int(paths.size()) || paths[std::size_t(index)].empty())
+		{
+			ec = make_error_code(boost::system::errc::invalid_argument);
+			return -1;
+		}
+		++open_count;
+		opened_files.push_back(file);
+		int const descriptor = ::open(paths[std::size_t(index)].c_str()
+			, (write ? O_RDWR : O_RDONLY) | O_CLOEXEC | O_NOFOLLOW);
+		if (descriptor < 0) ec = error_code(errno, system_category());
+		return descriptor;
+	}
+
+	std::int64_t payload_size(file_index_t const file, error_code& ec) override
+	{
+		int const index = static_cast<int>(file);
+		if (index < 0 || index >= int(paths.size()) || paths[std::size_t(index)].empty())
+		{
+			ec = make_error_code(boost::system::errc::invalid_argument);
+			return -1;
+		}
+		++stat_count;
+		struct ::stat status {};
+		if (::stat(paths[std::size_t(index)].c_str(), &status) != 0)
+		{
+			ec = error_code(errno, system_category());
+			return -1;
+		}
+		return status.st_size;
+	}
+
+	std::vector<std::string> paths;
+	std::vector<file_index_t> opened_files;
+	int open_count = 0;
+	int stat_count = 0;
+};
+
+std::shared_ptr<torrent_info const> setup_provider_torrent(std::vector<char>& metadata)
+{
+	constexpr int size = 0x4000;
+	std::vector<create_file_entry> files;
+	files.emplace_back("root/payload-a.bin", size / 2);
+	files.emplace_back("root/payload-b.bin", size);
+	lt::create_torrent torrent(std::move(files), size);
+	sha1_hash const hash = hasher(std::vector<char>(size, 0)).final();
+	torrent.set_hash(0_piece, hash);
+	torrent.set_hash(1_piece, hash);
+	metadata = bencode(torrent.generate());
+	return load_torrent_buffer(metadata).ti;
+}
+
+void create_empty_file(std::string const& path)
+{
+	int const descriptor = ::open(path.c_str(), O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	TEST_CHECK(descriptor >= 0);
+	if (descriptor >= 0) TEST_EQUAL(::close(descriptor), 0);
+}
+
+std::vector<char> read_file_bytes(std::string const& path)
+{
+	std::ifstream input(path, std::ios::binary);
+	return {std::istreambuf_iterator<char>(input), std::istreambuf_iterator<char>()};
+}
+
+void test_payload_provider_rejected_by_non_pread_storage()
+{
+	std::vector<char> metadata;
+	auto const info = setup_provider_torrent(metadata);
+	std::string const private_root = complete("provider-rejected-private");
+	error_code ec;
+	remove_all(private_root, ec);
+	ec.clear();
+	create_directories(private_root, ec);
+	TEST_CHECK(!ec);
+	auto provider = std::make_shared<test_payload_file_provider>(
+		std::vector<std::string>{complete("unused-provider-file"), {}, {}});
+	aux::vector<download_priority_t, file_index_t> priorities;
+	renamed_files renamed;
+	storage_params params{info->layout(), renamed, private_root, {}
+		, storage_mode_sparse, priorities, sha1_hash{}, info->v1(), info->v2(), provider};
+	int posix_pool = 0;
+	bool posix_rejected = false;
+	try
+	{
+		static_cast<void>(make_storage<posix_storage>(params, posix_pool));
+	}
+	catch (storage_error const& error)
+	{
+		posix_rejected = error.ec == boost::system::errc::operation_not_supported;
+	}
+	TEST_CHECK(posix_rejected);
+
+#if TORRENT_HAVE_MMAP || TORRENT_HAVE_MAP_VIEW_OF_FILE
+	aux::file_view_pool mmap_pool;
+	bool mmap_rejected = false;
+	try
+	{
+		static_cast<void>(make_storage<mmap_storage>(params, mmap_pool));
+	}
+	catch (storage_error const& error)
+	{
+		mmap_rejected = error.ec == boost::system::errc::operation_not_supported;
+	}
+	TEST_CHECK(mmap_rejected);
+#endif
+	remove_all(private_root, ec);
+	TEST_CHECK(!ec);
+}
+
+void test_payload_provider_has_no_path_fallback()
+{
+	std::string const private_root = complete("provider-private");
+	std::string const payload = complete("provider-payload");
+	std::string const payload2 = complete("provider-payload-2");
+	error_code ec;
+	remove_all(private_root, ec);
+	ec.clear();
+	remove(payload, ec);
+	ec.clear();
+	remove(payload2, ec);
+	ec.clear();
+	create_directories(private_root, ec);
+	TEST_CHECK(!ec);
+	create_empty_file(payload);
+	create_empty_file(payload2);
+
+	std::vector<char> metadata;
+	auto const info = setup_provider_torrent(metadata);
+	TEST_EQUAL(info->layout().num_files(), 3);
+	TEST_CHECK(info->layout().pad_file_at(1_file));
+	std::string const decoy = combine_path(
+		private_root, info->layout().file_path(0_file));
+	create_directories(parent_path(decoy), ec);
+	TEST_CHECK(!ec);
+	{
+		std::ofstream output(decoy, std::ios::binary);
+		output << "decoy";
+		TEST_CHECK(output.good());
+	}
+
+	auto provider = std::make_shared<test_payload_file_provider>(
+		std::vector<std::string>{payload, {}, payload2});
+	aux::vector<download_priority_t, file_index_t> priorities;
+	renamed_files renamed;
+	storage_params params{info->layout(), renamed, private_root, {}
+		, storage_mode_sparse, priorities, sha1_hash{}, info->v1(), info->v2(), provider};
+	aux::file_pool pool;
+	auto storage = make_storage<pread_storage>(params, pool);
+	aux::session_settings settings;
+	storage_error error;
+	storage->initialize(settings, error);
+	TEST_CHECK(!error);
+	TEST_CHECK(provider->stat_count > 0);
+
+	std::vector<char> bytes(0x4000, 'p');
+	TEST_EQUAL(write(storage, settings, span<char>(bytes), 0_piece, 0
+		, aux::open_mode::write, error), int(bytes.size()));
+	TEST_CHECK(!error);
+	TEST_EQUAL(provider->open_count, 1);
+	TEST_EQUAL(provider->opened_files.front(), 0_file);
+
+	// Piece zero crosses an explicit pad file; only the two payload indices may
+	// ever reach the provider.
+	TEST_EQUAL(write(storage, settings, span<char>(bytes), 1_piece, 0
+		, aux::open_mode::write, error), int(bytes.size()));
+	TEST_CHECK(!error);
+	TEST_EQUAL(provider->open_count, 2);
+	TEST_EQUAL(provider->opened_files.back(), 2_file);
+	TEST_CHECK(std::find(provider->opened_files.begin()
+		, provider->opened_files.end(), 1_file) == provider->opened_files.end());
+	TEST_CHECK(read_file_bytes(payload)
+		== std::vector<char>(bytes.begin(), bytes.begin() + 0x2000));
+	TEST_CHECK(read_file_bytes(payload2) == bytes);
+	TEST_CHECK(read_file_bytes(decoy) == std::vector<char>({'d', 'e', 'c', 'o', 'y'}));
+
+	storage->rename_file(0_file, "renamed.bin", error);
+	TEST_CHECK(error.ec == boost::system::errc::operation_not_supported);
+	error = {};
+	auto const moved = storage->move_storage(complete("provider-other")
+		, move_flags_t::always_replace_files, error);
+	TEST_CHECK(error.ec == boost::system::errc::operation_not_supported);
+	TEST_EQUAL(moved.second, private_root);
+	error = {};
+	storage->delete_files(session::delete_files, error);
+	TEST_CHECK(!error);
+	TEST_CHECK(exists(payload, ec));
+	TEST_CHECK(!ec);
+	TEST_CHECK(exists(payload2, ec));
+	TEST_CHECK(!ec);
+	TEST_CHECK(exists(decoy, ec));
+	TEST_CHECK(!ec);
+
+	storage.reset();
+	remove_all(private_root, ec);
+	TEST_CHECK(!ec);
+	remove(payload, ec);
+	TEST_CHECK(!ec);
+	remove(payload2, ec);
+	TEST_CHECK(!ec);
+}
