+#ifndef TORRENT_SWARM_METADATA_PARSER_HPP
+#define TORRENT_SWARM_METADATA_PARSER_HPP
+
+#include <memory>
+
+#include "libtorrent/config.hpp"
+#include "libtorrent/error_code.hpp"
+#include "libtorrent/fwd.hpp"
+#include "libtorrent/span.hpp"
+
+namespace libtorrent::aux {
+
+	// Parses a hash-verified info dictionary received from the swarm. The
+	// implementation is supplied by the embedding application so untrusted
+	// metadata does not enter libtorrent's native bdecode path.
+	struct TORRENT_EXTRA_EXPORT swarm_metadata_parser
+	{
+		virtual ~swarm_metadata_parser() = default;
+
+		virtual std::shared_ptr<torrent_info> parse(
+			span<char const> info, error_code& ec) noexcept = 0;
+	};
+
+}
+
+#endif // TORRENT_SWARM_METADATA_PARSER_HPP
