+	void torrent::capture_resume_data(resume_data_flags_t const flags,
+		std::shared_ptr<std::promise<resume_checkpoint_result>> completion)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		if (m_abort)
+		{
+			completion->set_value(std::unexpected(error_code{errors::torrent_removed}));
+			return;
+		}
+		auto const conditions = flags & torrent_handle::only_if_modified;
+		if (conditions && !(m_need_save_resume_data & conditions))
+		{
+			completion->set_value(std::nullopt);
+			return;
+		}
+		// Capture a prefix of native state before enqueueing its fence. Writes
+		// arriving after that fence must not enter this checkpoint, even if
+		// their network callbacks run before the fence's completion callback.
+		resume_checkpoint checkpoint;
+		write_resume_data(flags, checkpoint.params);
+		checkpoint.revision = m_resume_revision;
+		// The callback owns the snapshot, torrent and its one completion path.
+		// A caller timing out cannot invalidate any borrowed state.
+		auto finish = [self = shared_from_this(), response = std::move(completion), captured = std::move(checkpoint)]
+			(storage_error const& error) mutable
+		{
+			try
+			{
+				if (error || self->m_abort)
+				{
+					response->set_value(std::unexpected(error ? error.ec : error_code{errors::torrent_removed}));
+					return;
+				}
+				response->set_value(std::move(captured));
+			}
+			catch (...)
+			{
+				response->set_exception(std::current_exception());
+			}
+		};
+		// Every durable snapshot needs the partfile's slot mapping, including
+		// routine/policy saves that happen to include new download progress.
+		if (m_storage)
+		{
+			m_ses.disk_thread().async_checkpoint(m_storage, std::move(finish));
+			m_ses.deferred_submit_jobs();
+		}
+		else finish(storage_error{});
+	}
+
+	void torrent::acknowledge_resume_data(std::uint64_t const revision)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		if (revision == m_resume_revision && revision != std::numeric_limits<std::uint64_t>::max())
+		{
+			m_need_save_resume_data = resume_data_flags_t{};
+			state_updated();
+		}
+	}
