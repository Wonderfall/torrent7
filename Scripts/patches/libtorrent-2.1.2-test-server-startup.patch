diff --git a/test/test_server_startup.py b/test/test_server_startup.py
new file mode 100644
index 0000000000000000000000000000000000000000..c6e3631a028790b02c773003893360d384cfb08c
--- /dev/null
+++ b/test/test_server_startup.py
@@ -0,0 +1,63 @@
+import io
+from pathlib import Path
+import runpy
+import socket
+import socketserver
+import sys
+import unittest
+from contextlib import ExitStack, redirect_stdout
+from unittest.mock import patch
+
+
+class StartupComplete(Exception):
+    pass
+
+
+class ServerStartupTests(unittest.TestCase):
+    def check_startup(self, script, args, expected_host):
+        output = io.StringIO()
+        original_bind = socket.socket.bind
+
+        def bind_numeric(sock, address):
+            # socket.bind resolves hostnames in C, outside the Python DNS APIs.
+            socket.inet_pton(sock.family, address[0])
+            return original_bind(sock, address)
+
+        def check_ready(server):
+            # Stop at the request loop after exercising the real entry point,
+            # bind, listen, and readiness report. Always close the listener.
+            with server:
+                host, port = server.server_address
+                self.assertEqual(host, expected_host)
+                self.assertGreater(port, 0)
+                self.assertIn(f'LISTENING_PORT {port}', output.getvalue().splitlines())
+                with socket.socket() as client:
+                    client.settimeout(1)
+                    client.connect(('127.0.0.1', port))
+            raise StartupComplete
+
+        with ExitStack() as stack:
+            stack.enter_context(redirect_stdout(output))
+            stack.enter_context(patch.object(sys, 'argv', [script, *args]))
+            stack.enter_context(patch.object(socket.socket, 'bind', bind_numeric))
+            for name in ('getfqdn', 'getaddrinfo', 'gethostbyaddr',
+                         'gethostbyname', 'gethostbyname_ex'):
+                stack.enter_context(patch.object(socket, name, side_effect=AssertionError(
+                    f'fixture startup must not call socket.{name}')))
+            for name in ('handle_request', 'serve_forever'):
+                stack.enter_context(patch.object(socketserver.BaseServer, name, check_ready))
+            with self.assertRaises(StartupComplete):
+                runpy.run_path(str(Path(__file__).with_name(script)), run_name='__main__')
+
+    def test_web_server(self):
+        self.check_startup('web_server.py', ['0', '0', '1', '0'], '0.0.0.0')
+
+    def test_http_proxy(self):
+        self.check_startup('http_proxy.py', [], '127.0.0.1')
+
+    def test_socks_proxy(self):
+        self.check_startup('socks.py', [], '127.0.0.1')
+
+
+if __name__ == '__main__':
+    unittest.main()
