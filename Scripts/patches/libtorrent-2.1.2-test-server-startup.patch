--- /dev/null
+++ b/test/test_web_server.py
@@ -0,0 +1,22 @@
+import socket
+import unittest
+from unittest.mock import patch
+
+from web_server import http_handler, http_server_with_timeout
+
+
+class WebServerStartupTests(unittest.TestCase):
+    def test_bind_without_hostname_resolution(self):
+        with patch.object(socket, 'getfqdn', side_effect=AssertionError(
+                'fixture startup must not depend on DNS')) as getfqdn:
+            with http_server_with_timeout(('0.0.0.0', 0), http_handler) as server:
+                self.assertEqual(server.server_name, '0.0.0.0')
+                self.assertEqual(server.server_port, server.server_address[1])
+                self.assertGreater(server.server_port, 0)
+                with socket.create_connection(('127.0.0.1', server.server_port), timeout=1):
+                    pass
+            getfqdn.assert_not_called()
+
+
+if __name__ == '__main__':
+    unittest.main()
