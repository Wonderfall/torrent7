+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wallocator-wrappers"
+	// AppleClang diagnoses typed allocator targets even though they consume the
+	// compiler-provided type. Keep that false positive local.
+	static void* allocate_typed(size_type const bytes, malloc_type_id_t const type)
+	{
+		void* const block = malloc_type_malloc(bytes, type);
+		if (block == nullptr) throw std::bad_alloc();
+		return block;
+	}
+#pragma clang diagnostic pop
+
+	static void* allocate(size_type const bytes)
+		_MALLOC_TYPED(allocate_typed, 1);
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wallocator-wrappers"
+	// Boost requires this exact wrapper signature. The inner annotated call
+	// preserves the pool-allocation descriptor despite the required char* API.
+	static char* malloc(size_type const bytes)
+	{
+		auto* const block = static_cast<pool_allocation*>(allocate(bytes));
+		return reinterpret_cast<char*>(block);
+	}
+#pragma clang diagnostic pop
+#else
 	static char* malloc(size_type const bytes)
 	{ return new char[bytes]; }
+#endif
+
