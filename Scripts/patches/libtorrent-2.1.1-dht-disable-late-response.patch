+#ifndef TORRENT_DISABLE_DHT
+TORRENT_TEST(disable_dht_discards_late_announce_response)
+{
+	settings_pack pack = settings();
+	pack.set_int(settings_pack::alert_mask, alert_category::dht);
+	session ses(pack);
+
+	add_torrent_params params = make_torrent({{"test", default_block_size}}
+		, default_block_size);
+	params.save_path = ".";
+	params.flags |= torrent_flags::paused;
+	torrent_handle const handle = ses.add_torrent(std::move(params));
+	auto const torrent = handle.native_handle();
+
+	std::vector<alert*> initial_alerts;
+	ses.pop_alerts(&initial_alerts);
+
+	struct response_result
+	{
+		bool existing_added;
+		bool existing_retained;
+		bool late_added;
+	};
+
+	std::promise<response_result> completed;
+	auto result = completed.get_future();
+	post(ses.native_handle()->get_context(), [torrent, &completed] {
+		tcp::endpoint const existing = ep("8.8.8.8", 6881);
+		tcp::endpoint const late = ep("1.1.1.1", 6881);
+		bool const existing_added = torrent->add_peer(existing, peer_info::tracker) != nullptr;
+		torrent->set_flags(torrent_flags::disable_dht, torrent_flags::disable_dht);
+		aux::dht_announce_response_test_access::deliver(
+			*torrent, protocol_version::V1, {late});
+
+		auto const existing_range = torrent->find_peers(existing.address());
+		auto const late_range = torrent->find_peers(late.address());
+		completed.set_value({
+			existing_added,
+			existing_range.first != existing_range.second,
+			late_range.first != late_range.second,
+		});
+	});
+
+	response_result const response = result.get();
+	TEST_CHECK(response.existing_added);
+	TEST_CHECK(response.existing_retained);
+	TEST_CHECK(!response.late_added);
+
+	std::vector<alert*> alerts;
+	ses.pop_alerts(&alerts);
+	TEST_CHECK(std::none_of(alerts.begin(), alerts.end(), [](alert const* alert) {
+		return alert_cast<dht_reply_alert>(alert) != nullptr;
+	}));
+}
+#endif
