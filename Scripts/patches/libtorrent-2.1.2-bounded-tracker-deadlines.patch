+#ifndef TORRENT_TRACKER_DEADLINE_HPP
+#define TORRENT_TRACKER_DEADLINE_HPP
+
+#include "libtorrent/time.hpp"
+#include <optional>
+
+namespace libtorrent::aux {
+
+// Operational policy, independent of the signed 32-bit deadline representation.
+inline constexpr seconds32 maximum_tracker_announce_interval{7 * 24 * 60 * 60};
+
+[[nodiscard]] constexpr bool valid_tracker_announce_interval(seconds32 interval)
+{
+    return interval >= seconds32{0} && interval <= maximum_tracker_announce_interval;
+}
+
+struct tracker_announce_deadlines
+{
+    time_point32 next_announce;
+    time_point32 min_announce;
+};
+
+// HTTP and UDP share this boundary. Validate both fields before publishing either
+// deadline. Even an allowed duration can exceed the clock's remaining range.
+[[nodiscard]] inline std::optional<tracker_announce_deadlines> make_tracker_announce_deadlines(
+    time_point32 now, seconds32 interval, seconds32 minimum_interval)
+{
+    if (!valid_tracker_announce_interval(interval)
+        || !valid_tracker_announce_interval(minimum_interval)) return std::nullopt;
+    auto const deadline = [now](seconds32 delay)
+    {
+        return now > time_point32::max() - delay ? time_point32::max() : now + delay;
+    };
+    return tracker_announce_deadlines{deadline(interval), deadline(minimum_interval)};
+}
+
+}
+#endif
