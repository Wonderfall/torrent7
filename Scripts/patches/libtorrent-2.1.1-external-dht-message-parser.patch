+// The application supplies the production DHT parser. These helpers keep the
+// upstream DHT unit tests self-contained without restoring a native parser to
+// the production packet path.
+krpc_query_kind test_query_kind(string_view const name)
+{
+	if (name == "ping") return krpc_query_kind::ping;
+	if (name == "find_node") return krpc_query_kind::find_node;
+	if (name == "get_peers") return krpc_query_kind::get_peers;
+	if (name == "announce_peer") return krpc_query_kind::announce_peer;
+	if (name == "sample_infohashes") return krpc_query_kind::sample_infohashes;
+	if (name == "get") return krpc_query_kind::get_item;
+	if (name == "put") return krpc_query_kind::put_item;
+	return krpc_query_kind::unknown;
+}
+
+std::optional<sha1_hash> test_hash(bdecode_node const& dict, string_view const key)
+{
+	bdecode_node const value = dict.dict_find_string(key);
+	if (!value || value.string_length() != 20) return std::nullopt;
+	return sha1_hash(value.string_ptr());
+}
+
+bool test_optional_flag(bdecode_node const& dict, string_view const key, bool& result)
+{
+	bdecode_node const value = dict.dict_find(key);
+	if (!value) return true;
+	if (value.type() != bdecode_node::int_t) return false;
+	result = value.int_value() != 0;
+	return true;
+}
+
+bool test_parse_want(bdecode_node const& arguments, krpc_message& message)
+{
+	bdecode_node const want = arguments.dict_find("want");
+	if (!want) return true;
+	message.wants_specified = true;
+	if (want.type() != bdecode_node::list_t) return false;
+	for (int i = 0; i < want.list_size(); ++i)
+	{
+		bdecode_node const item = want.list_at(i);
+		if (item.type() != bdecode_node::string_t) continue;
+		if (item.string_value() == "n4") message.wants_ipv4 = true;
+		else if (item.string_value() == "n6") message.wants_ipv6 = true;
+	}
+	return true;
+}
+
+bool test_append_nodes(bdecode_node const& response, string_view const key
+	, udp const protocol, krpc_message& message)
+{
+	bdecode_node const encoded = response.dict_find_string(key);
+	if (!encoded) return true;
+	char const* cursor = encoded.string_ptr();
+	char const* const end = cursor + encoded.string_length();
+	std::ptrdiff_t const stride = protocol == udp::v4() ? 26 : 38;
+	while (end - cursor >= stride)
+	{
+		if (message.nodes.size() == 64) return false;
+		node_endpoint const endpoint = read_node_endpoint(protocol, cursor);
+		message.nodes.push_back({endpoint.id, endpoint.ep});
+	}
+	return true;
+}
+
+bool test_append_peer(string_view const encoded, krpc_message& message)
+{
+	if (message.peers.size() == 256) return false;
+	char const* cursor = encoded.data();
+	if (encoded.size() == 6)
+		message.peers.push_back(aux::read_v4_endpoint<tcp::endpoint>(cursor));
+	else if (encoded.size() == 18)
+		message.peers.push_back(aux::read_v6_endpoint<tcp::endpoint>(cursor));
+	return true;
+}
+
+bool test_parse_peers(bdecode_node const& response, bool const source_is_ipv6
+	, krpc_message& message)
+{
+	bdecode_node const values = response.dict_find("values");
+	if (!values || values.type() != bdecode_node::list_t) return true;
+	message.peers_present = true;
+
+	if (!source_is_ipv6 && values.list_size() == 1)
+	{
+		bdecode_node const aggregate = values.list_at(0);
+		if (aggregate.type() != bdecode_node::string_t) return true;
+		string_view encoded = aggregate.string_value();
+		while (encoded.size() >= 6)
+		{
+			if (!test_append_peer(encoded.substr(0, 6), message)) return false;
+			encoded.remove_prefix(6);
+		}
+		return true;
+	}
+
+	for (int i = 0; i < values.list_size(); ++i)
+	{
+		bdecode_node const item = values.list_at(i);
+		if (item.type() != bdecode_node::string_t)
+		{
+			message.peers.clear();
+			return true;
+		}
+		if (!test_append_peer(item.string_value(), message)) return false;
+	}
+	return true;
+}
+
+bool test_parse_query(bdecode_node const& root, krpc_message& message)
+{
+	bdecode_node const query = root.dict_find_string("q");
+	if (!query || query.string_length() == 0 || query.string_length() > 32)
+		return true;
+	message.query_name.assign(query.string_ptr(), std::size_t(query.string_length()));
+	message.query = test_query_kind(query.string_value());
+
+	bdecode_node const arguments = root.dict_find_dict("a");
+	if (!arguments) return true;
+	message.sender_id = test_hash(arguments, "id");
+	bool valid = message.sender_id.has_value()
+		&& test_optional_flag(root, "ro", message.read_only);
+
+	auto const target = [&]
+	{
+		message.target = test_hash(arguments, "target");
+		return message.target.has_value();
+	};
+	auto const info_hash = [&]
+	{
+		message.target = test_hash(arguments, "info_hash");
+		return message.target.has_value();
+	};
+
+	switch (message.query)
+	{
+		case krpc_query_kind::ping:
+		case krpc_query_kind::get_item:
+		case krpc_query_kind::put_item:
+			break;
+		case krpc_query_kind::find_node:
+		case krpc_query_kind::sample_infohashes:
+			valid = target() && valid;
+			valid = test_parse_want(arguments, message) && valid;
+			break;
+		case krpc_query_kind::get_peers:
+			valid = info_hash() && valid;
+			valid = test_optional_flag(arguments, "noseed", message.noseed) && valid;
+			valid = test_optional_flag(arguments, "scrape", message.scrape) && valid;
+			valid = test_parse_want(arguments, message) && valid;
+			break;
+		case krpc_query_kind::announce_peer:
+		{
+			valid = info_hash() && valid;
+			bdecode_node const port = arguments.dict_find_int("port");
+			if (port && port.int_value() >= 0 && port.int_value() <= 65535)
+				message.port = std::uint16_t(port.int_value());
+			else
+				valid = false;
+			bdecode_node const token = arguments.dict_find_string("token");
+			if (token && token.string_length() <= 64)
+				message.token = std::string(token.string_value());
+			else
+				valid = false;
+			bdecode_node const name = arguments.dict_find("n");
+			if (name)
+			{
+				if (name.type() != bdecode_node::string_t || name.string_length() > 255
+					|| name.string_value().find('\0') != string_view::npos)
+					valid = false;
+				else
+					message.name.assign(name.string_ptr(), std::size_t(name.string_length()));
+			}
+			valid = test_optional_flag(arguments, "seed", message.seed) && valid;
+			valid = test_optional_flag(arguments, "implied_port", message.implied_port) && valid;
+			break;
+		}
+		case krpc_query_kind::unknown:
+			message.target = test_hash(arguments, "target");
+			if (!message.target) message.target = test_hash(arguments, "info_hash");
+			valid = message.target.has_value() && valid;
+			valid = test_parse_want(arguments, message) && valid;
+			break;
+		case krpc_query_kind::none:
+			valid = false;
+			break;
+	}
+	message.query_valid = valid;
+	return true;
+}
+
+bool test_parse_response(bdecode_node const& root, bool const source_is_ipv6
+	, krpc_message& message)
+{
+	bdecode_node const response = root.dict_find_dict("r");
+	if (!response) return true;
+	message.sender_id = test_hash(response, "id");
+	bdecode_node const token = response.dict_find_string("token");
+	if (token && token.string_length() <= 64)
+		message.token = std::string(token.string_value());
+	if (!test_append_nodes(response, "nodes", udp::v4(), message)
+		|| !test_append_nodes(response, "nodes6", udp::v6(), message)
+		|| !test_parse_peers(response, source_is_ipv6, message))
+		return false;
+
+	auto const nonnegative_int32 = [&response](string_view const key)
+		-> std::optional<std::int32_t>
+	{
+		bdecode_node const value = response.dict_find_int(key);
+		if (!value || value.int_value() < 0
+			|| value.int_value() > std::numeric_limits<std::int32_t>::max())
+			return std::nullopt;
+		return std::int32_t(value.int_value());
+	};
+	message.interval = nonnegative_int32("interval");
+	message.total_infohash_count = nonnegative_int32("num");
+
+	bdecode_node const samples = response.dict_find_string("samples");
+	if (samples && samples.string_length() % 20 == 0
+		&& samples.string_length() / 20 <= 64)
+	{
+		message.samples_present = true;
+		char const* cursor = samples.string_ptr();
+		for (int i = 0; i < samples.string_length() / 20; ++i, cursor += 20)
+			message.samples.emplace_back(cursor);
+	}
+	return true;
+}
+
+bool test_parse_error(bdecode_node const& root, krpc_message& message)
+{
+	bdecode_node const error = root.dict_find_list("e");
+	if (!error || error.list_size() < 2) return true;
+	bdecode_node const code = error.list_at(0);
+	bdecode_node const text = error.list_at(1);
+	if (code.type() != bdecode_node::int_t
+		|| code.int_value() < std::numeric_limits<std::int32_t>::min()
+		|| code.int_value() > std::numeric_limits<std::int32_t>::max()
+		|| text.type() != bdecode_node::string_t || text.string_length() > 256
+		|| text.string_value().find('\0') != string_view::npos)
+		return true;
+	message.error_code = std::int32_t(code.int_value());
+	message.error_message.assign(text.string_ptr(), std::size_t(text.string_length()));
+	return true;
+}
+
+bool test_parse_krpc_message(bdecode_node const& root, bool const source_is_ipv6
+	, krpc_message& result)
+{
+	if (root.type() != bdecode_node::dict_t) return false;
+	bdecode_node const type = root.dict_find_string("y");
+	if (!type || type.string_length() != 1) return false;
+
+	krpc_message message;
+	if (bdecode_node const transaction = root.dict_find_string("t")
+		; transaction && transaction.string_length() <= 64)
+		message.transaction_id.assign(transaction.string_ptr()
+			, std::size_t(transaction.string_length()));
+	if (bdecode_node const ip = root.dict_find_string("ip"))
+	{
+		char const* cursor = ip.string_ptr();
+		if (ip.string_length() == 6)
+			message.external_address = aux::read_v4_endpoint<udp::endpoint>(cursor).address();
+		else if (ip.string_length() == 18)
+			message.external_address = aux::read_v6_endpoint<udp::endpoint>(cursor).address();
+	}
+
+	switch (type.string_ptr()[0])
+	{
+		case 'q':
+			message.kind = krpc_message_kind::query;
+			if (!test_parse_query(root, message)) return false;
+			break;
+		case 'r':
+			message.kind = krpc_message_kind::response;
+			message.query_valid = true;
+			if (!test_parse_response(root, source_is_ipv6, message)) return false;
+			break;
+		case 'e':
+			message.kind = krpc_message_kind::error;
+			message.query_valid = true;
+			if (!test_parse_error(root, message)) return false;
+			break;
+		default:
+			return false;
+	}
+	result = std::move(message);
+	return true;
+}
+
+krpc_message test_krpc_message(bdecode_node const& root, bool const source_is_ipv6)
+{
+	krpc_message result;
+	TEST_CHECK(test_parse_krpc_message(root, source_is_ipv6, result));
+	return result;
+}
+
+struct test_dht_message_parser final : aux::dht_message_parser
+{
+	bool parse_message(span<char const> const body, bool const source_is_ipv6
+		, krpc_message& result) noexcept override
+	{
+		try
+		{
+			if (body.empty() || body.size() > maximum_message_size) return false;
+			bdecode_node root;
+			error_code error;
+			int position = 0;
+			if (bdecode(body.data(), body.data() + body.size(), root, error
+					, &position, 10, 500) != 0 || error)
+				return false;
+			return test_parse_krpc_message(root, source_is_ipv6, result);
+		}
+		catch (...)
+		{
+			return false;
+		}
+	}
+};
+
+std::shared_ptr<aux::dht_message_parser> test_dht_parser()
+{
+	return std::make_shared<test_dht_message_parser>();
+}
