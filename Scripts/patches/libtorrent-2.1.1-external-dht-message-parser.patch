diff --git a/include/libtorrent/kademlia/krpc_message.hpp b/include/libtorrent/kademlia/krpc_message.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..506f88cef1cce81a36305a06a6f6d0557c0b4634
--- /dev/null
+++ b/include/libtorrent/kademlia/krpc_message.hpp
@@ -0,0 +1,86 @@
+/*
+
+Copyright (c) 2026, Torrent7 contributors
+All rights reserved.
+
+You may use, distribute and modify this code under the terms of the BSD license,
+see LICENSE file.
+*/
+
+#ifndef TORRENT_KADEMLIA_KRPC_MESSAGE_HPP
+#define TORRENT_KADEMLIA_KRPC_MESSAGE_HPP
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "libtorrent/kademlia/node_id.hpp"
+#include "libtorrent/socket.hpp"
+
+namespace libtorrent::dht {
+
+	enum class krpc_message_kind : std::uint8_t
+	{
+		none = 0,
+		query = 1,
+		response = 2,
+		error = 3,
+	};
+
+	enum class krpc_query_kind : std::uint8_t
+	{
+		none = 0,
+		ping = 1,
+		find_node = 2,
+		get_peers = 3,
+		announce_peer = 4,
+		sample_infohashes = 5,
+		get_item = 6,
+		put_item = 7,
+		unknown = 255,
+	};
+
+	struct krpc_node
+	{
+		node_id id;
+		udp::endpoint endpoint;
+	};
+
+	// Fully owning typed syntax for one inbound KRPC datagram. Stateful routing,
+	// transaction, token, endpoint, and admission decisions remain in the DHT.
+	struct krpc_message
+	{
+		krpc_message_kind kind = krpc_message_kind::none;
+		krpc_query_kind query = krpc_query_kind::none;
+		bool query_valid = false;
+		std::string transaction_id;
+		std::string query_name;
+		std::optional<node_id> sender_id;
+		std::optional<sha1_hash> target;
+		std::optional<std::string> token;
+		std::string name;
+		std::optional<std::int32_t> error_code;
+		std::string error_message;
+		std::optional<address> external_address;
+		std::optional<std::uint16_t> port;
+		bool read_only = false;
+		bool noseed = false;
+		bool scrape = false;
+		bool seed = false;
+		bool implied_port = false;
+		bool wants_specified = false;
+		bool wants_ipv4 = false;
+		bool wants_ipv6 = false;
+		std::optional<std::int32_t> interval;
+		std::optional<std::int32_t> total_infohash_count;
+		std::vector<krpc_node> nodes;
+		bool peers_present = false;
+		std::vector<tcp::endpoint> peers;
+		bool samples_present = false;
+		std::vector<sha1_hash> samples;
+	};
+
+}
+
+#endif // TORRENT_KADEMLIA_KRPC_MESSAGE_HPP
