+
+#ifndef TORRENT_DHT_MESSAGE_PARSER_HPP
+#define TORRENT_DHT_MESSAGE_PARSER_HPP
+
+#include "libtorrent/aux_/export.hpp"
+#include "libtorrent/kademlia/krpc_message.hpp"
+#include "libtorrent/span.hpp"
+
+namespace libtorrent::aux {
+
+	// Parses exactly one complete inbound DHT datagram into owning KRPC syntax.
+	// The parser is supplied by the embedding application. No native bdecode
+	// fallback is used when it is absent or rejects a message.
+	struct TORRENT_EXTRA_EXPORT dht_message_parser
+	{
+		static constexpr int maximum_message_size = 1500;
+
+		virtual ~dht_message_parser() = default;
+
+		virtual bool parse_message(span<char const> body, bool source_is_ipv6
+			, dht::krpc_message& result) noexcept = 0;
+	};
+
+}
+
+#endif // TORRENT_DHT_MESSAGE_PARSER_HPP
